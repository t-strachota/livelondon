{
  "name": "london-live-buses",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --use-env-proxy --env-file-if-exists=.env server.mjs",
    "build-roads": "node lib/run-python.mjs build_roads.py",
    "test": "node --test test/*.test.mjs",
    "test:sim": "node lib/run-python.mjs -m unittest discover -s sim/tests -t . -v",
    "test:browser": "node test/browser.mjs",
    "test:overlays": "node test/overlays.mjs",
    "test:integration": "node test/ui-integration.mjs"
  },
  "engines": {
    "node": ">=24.5"
  },
  "dependencies": {
    "@mapbox/vector-tile": "3.0.0",
    "fast-xml-parser": "^5.11.2",
    "maplibre-gl": "6.15.0",
    "pbf": "5.1.2",
    "three": "0.169.0",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "playwright": "1.56.1",
    "pngjs": "^7.0.0"
  }
}

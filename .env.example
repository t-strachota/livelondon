# Free key from https://data.bus-data.dft.gov.uk/ (separate from a TfL Unified API key).
BODS_API_KEY=
PORT=3000
# Optional TfL Unified API key (https://api-portal.tfl.gov.uk/) for live trains; used only by the server.
# Without it, train data uses TfL's anonymous rate limit, which one call every 15 s fits within.
TFL_APP_KEY=
